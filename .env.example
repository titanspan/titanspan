# Application identity and local URL (config/app.py).
APP_NAME=Titanspan
APP_ENV=local
APP_DEBUG=false
APP_URL=http://127.0.0.1:8000

# Console logging is the default. Select `single` for storage/logs/titanspan.log.
LOG_CHANNEL=console
LOG_LEVEL=info

# Memory Cache is local by default. Redis is an optional external store.
CACHE_STORE=memory
CACHE_PREFIX=titanspan
CACHE_REDIS_URL=redis://127.0.0.1:6379/0

# Local private Filesystem storage is the default disk.
FILESYSTEM_DISK=local

# Queue executes jobs inline by default. Broker connections are optional.
QUEUE_CONNECTION=sync
QUEUE_DEFAULT_QUEUE=default
QUEUE_NAMESPACE=titanspan
QUEUE_REDIS_URL=redis://127.0.0.1:6379/0
QUEUE_RABBITMQ_URL=amqp://localhost:5672/%2F

# Native password hashing defaults to Argon2id.
HASHING_DRIVER=argon2id
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST=65536
ARGON2_PARALLELISM=4
ARGON2_HASH_LENGTH=32
ARGON2_SALT_LENGTH=16
BCRYPT_ROUNDS=12
BCRYPT_PREFIX=2b
HASH_MAX_CONCURRENCY=2

# Native HTTP server and client limits.
HTTP_MAX_BODY_SIZE=10485760
HTTP_MAX_FORM_FILES=100
HTTP_MAX_FORM_FIELDS=1000
HTTP_MAX_PART_SIZE=1048576
HTTP_CLIENT_TIMEOUT=5.0
HTTP_CONNECT_TIMEOUT=5.0
HTTP_MAX_CONNECTIONS=100
HTTP_MAX_KEEPALIVE_CONNECTIONS=20
HTTP_KEEPALIVE_EXPIRY=5.0
HTTP_FOLLOW_REDIRECTS=false
HTTP_VERIFY_TLS=true
HTTP_CLIENT_BASE_URL=
HTTP_CLIENT_HTTP2=false

# Native route discovery and Events manifest location.
ROUTES_DISCOVER=true
EVENTS_MANIFEST_PATH=bootstrap/cache/events.json

# Native validation settings.
VALIDATION_STRICT=false
VALIDATION_FROM_ATTRIBUTES=false
